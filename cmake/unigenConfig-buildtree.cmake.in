# Config file for the Build-tree unigen package (not relocatable).
set(UNIGEN_INCLUDE_DIRS "@CMAKE_CURRENT_BINARY_DIR@/include")
include("${CMAKE_CURRENT_LIST_DIR}/unigenTargets.cmake")
set(UNIGEN_LIBRARIES unigen)
set(UNIGEN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(UNIGEN_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(UNIGEN_EXECUTABLE unigen)
